# Disables USB autosuspend for the devices that need to deliver a
# continuous, gapless stream with no visible failure signal if the kernel
# power-suspends them mid-run: the mic (src/sensing/audio.py), the
# MT7612U WiFi dongle hosting the node hotspot, the M5Stack accel stick
# (src/sensing/accel_stick.py), and the USB-DMX interface (src/output/dmx.py).
# Deliberately NOT applied to the terminal's mouse/keyboard - autosuspend
# is safe there (HID remote wakeup is instant and designed for exactly
# this) and there's no reason to give up the power saving on those.
#
# Install on the Pi:
#   sudo cp 99-usb-no-autosuspend.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Verify (should print "on" for each device once its rule's filled in and
# the device is plugged in - "auto" means the rule isn't matching):
#   cat /sys/bus/usb/devices/*/power/control

# USB Hub 2 addresses
# Bus 001 Device 008: ID 2e8a:000d Raspberry Pi USB3 HUB
# Bus 004 Device 002: ID 2e8a:000e Raspberry Pi USB3 HUB
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="000d", TEST=="power/control", ATTR{power/control}="on"
SUBSYSTEM=="usb", ATTR{idVendor}=="2e8a", ATTR{idProduct}=="000e", TEST=="power/control", ATTR{power/control}="on"

# Mic (see audio.py's STALE_AFTER_SECONDS comment for the failure mode this prevents)
# Bus 003 Device 009: ID 08bb:2902 Texas Instruments PCM2902 Audio Codec
SUBSYSTEM=="usb", ATTR{idVendor}=="08bb", ATTR{idProduct}=="2902", TEST=="power/control", ATTR{power/control}="on"

# MT7612U WiFi dongle (wlan1, hosts the node hotspot)
# Bus 004 Device 003: ID 0e8d:7612 MediaTek Inc. MT7612U 802.11a/b/g/n/ac Wireless Adapter
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", ATTR{idProduct}=="7612", TEST=="power/control", ATTR{power/control}="on"

# M5Stack accel stick (USB-serial)
# Bus 001 Device 014: ID 303a:1001 Espressif USB JTAG/serial debug unit
SUBSYSTEM=="usb", ATTR{idVendor}=="303a", ATTR{idProduct}=="1001", TEST=="power/control", ATTR{power/control}="on"

# USB-DMX interface (USB-serial, FTDI or CH340 - see dmx.py's module docstring)
# Bus 001 Device 015: ID 0403:6001 Future Technology Devices International, Ltd FT232 Serial (UART) IC
SUBSYSTEM=="usb", ATTR{idVendor}=="0403", ATTR{idProduct}=="6001", TEST=="power/control", ATTR{power/control}="on"
